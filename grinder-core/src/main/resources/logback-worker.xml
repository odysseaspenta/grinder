<configuration>

  <property name="PREFIX" value="${LOG_DIRECTORY}/${WORKER_NAME}" />

  <appender name="log-file"
    class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${PREFIX}.log</file>

    <encoder>
      <pattern>%d %-5level %logger{0} %marker: %message%n</pattern>
    </encoder>

    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${PREFIX}.log%i</fileNamePattern>
      <minIndex>1</minIndex>
      <maxIndex>1</maxIndex>
    </rollingPolicy>

    <triggeringPolicy class="net.grinder.util.logback.RollOnStartUp" />

  </appender>

  <appender name="data-file"
    class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${PREFIX}-data.log</file>

    <!-- The data log is written per test, so buffer it; the worker stops
         the logger context on exit, which flushes. -->
    <immediateFlush>false</immediateFlush>
    <bufferSize>64KB</bufferSize>

    <encoder class="net.grinder.util.logback.EchoMessageEncoder"/>

    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${PREFIX}-data.log%i</fileNamePattern>
      <minIndex>1</minIndex>
      <maxIndex>1</maxIndex>
    </rollingPolicy>

    <triggeringPolicy class="net.grinder.util.logback.RollOnStartUp" />

  </appender>


  <!-- logback.xml is loaded first and sets the root level to warn by
       default; without a level of its own this logger would inherit it and
       the worker log would hold nothing but warnings. -->
  <logger name="worker" level="${grinder.logLevel:-info}" additivity="false">
    <appender-ref ref="log-file" />
  </logger>

  <logger name="data" additivity="false" level="info">
    <appender-ref ref="data-file" />
  </logger>

</configuration>
